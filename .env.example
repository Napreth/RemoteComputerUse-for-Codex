# Copy only the backend you use into the MCP server environment. Do not commit
# real credentials.
REMOTE_COMPUTER_BACKEND="rdp"

REMOTE_COMPUTER_RDP_HOST=""
REMOTE_COMPUTER_RDP_PORT="3389"
REMOTE_COMPUTER_RDP_USERNAME=""
REMOTE_COMPUTER_RDP_PASSWORD=""
REMOTE_COMPUTER_RDP_DOMAIN=""
REMOTE_COMPUTER_RDP_WIDTH="1440"
REMOTE_COMPUTER_RDP_HEIGHT="900"
REMOTE_COMPUTER_RDP_INSECURE_TLS="false"

# REMOTE_COMPUTER_VNC_HOST=""
# REMOTE_COMPUTER_VNC_PORT="5900"
# REMOTE_COMPUTER_VNC_PASSWORD=""
# REMOTE_COMPUTER_VNC_SHARED="true"

# Required only by retained Labs/scenario runs. Windows is the currently
# supported guest workflow.
# REMOTE_COMPUTER_GUEST_OS="windows"
# REMOTE_COMPUTER_LAB_HOST="192.0.2.1"
# REMOTE_COMPUTER_LAB_BIND_HOST="192.0.2.1"
# REMOTE_COMPUTER_LAB_PORT="0"
# Expected HTTP source of the guest; defaults to the RDP/VNC host. Override for
# forwarded desktop connections or NAT; requests from other peers are rejected.
# REMOTE_COMPUTER_LAB_GUEST_HOST="192.0.2.10"

# VNC Labs require a Windows server verified to forward Win+R to the guest.
# REMOTE_COMPUTER_VNC_WINDOWS_NAVIGATION="win-r"
